-- allium: 3
-- horizontal-scroll.allium

-- Scope: Horizontal-scroll-aware rendering of pipe tables
-- Includes:
--   - Table geometry (delimiter and row column widths measured in display columns)
--   - Re-render triggers when the viewing window's horizontal scroll changes
--   - Trim/clip behaviour applied to delimiter and row overlays when scrolled
--   - Debounced render pipeline (leading + trailing edge) that issues overlays
--   - Invariants that guarantee visual alignment between rows and the delimiter
-- Excludes:
--   - Markdown parsing (tree-sitter, handled upstream)
--   - The neovim extmark / virtual-text API itself (treated as an output sink)
--   - Non-table rendering (headings, code blocks, horizontal rules, lists)
--   - Cell-mode configuration as a feature (only referenced where it interacts
--     with horizontal scroll)
--   - Anti-conceal refresh policy (see separate spec)
--
-- History: three bugs in the byte-vs-display family have surfaced
-- and been fixed. All three were invisible to existing property tests
-- until a screen-grid (Layer 2) probe or a targeted byte-col
-- assertion was added:
--   1. build_row_line (render/markdown/table.lua) extracted cell content
--      by passing byte offsets to str.sub, which interprets its
--      arguments as DISPLAY columns. For ASCII tables byte == display
--      and it happened to work; for CJK/emoji cells the extracted
--      content was mis-sliced, so data rows ended up wider than the
--      delimiter and violated invariant I1 (AllRowsMatchDelimiterWidth).
--   2. str.sub itself dropped multi-column glyphs that straddled the
--      start or end of the requested range, returning a string whose
--      display width was less than (j - i + 1). Fix: substitute the
--      visible portion of the clipped glyph with spaces to preserve
--      display width. This property now has its own invariant (I6).
--   3. Render:row and Render:delimiter passed leftcol (a DISPLAY
--      column) directly as the extmark's col parameter, which
--      nvim_buf_set_extmark treats as a BYTE offset. For rows whose
--      source contains multi-byte glyphs before leftcol (emoji, CJK),
--      the mark was placed at a byte position that corresponds to a
--      display column STRICTLY LESS than leftcol. With
--      virt_text_pos='overlay', the overlay's leading display columns
--      then landed offscreen and were silently clipped by neovim's
--      scroll, leaving the visible portion of the overlay shifted to
--      the right of where it should be. Because no existing invariant
--      or test inspected the extmark's byte col directly, and because
--      the visible clip effect looked superficially similar to correct
--      rendering, the regression persisted across multiple iterations
--      of the hscroll work. Fix: convert leftcol to a byte offset via
--      str.col_to_byte(row.text, leftcol) before passing to
--      nvim_buf_set_extmark. This property is now I7 below.
--
-- A note on the Layer 2 probe: inspecting screen output alone cannot
-- distinguish "overlay is placed correctly" from "overlay was shifted
-- by N cols and the leading N cols got clipped offscreen" -- both
-- produce the same visible grid. Detecting bug 3 required either a
-- Layer 1 assertion about the extmark's byte col, or a Layer 2 probe
-- of screenattr to notice that leading cells had the buffer's
-- highlight rather than the overlay's.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The editor window that observes the buffer. Horizontal scroll offset and
-- visible width are the only properties this spec cares about.
external entity Window {
    leftcol: Integer
    width: Integer
    topline: Integer
}

-- The buffer whose contents are being rendered. Only the change tick is used
-- as a freshness token.
external entity Buffer {
    changedtick: Integer
}

-- Rendered output sink. Every visual overlay this spec produces is an
-- Extmark placed on the buffer by the runtime. Treated as fire-and-forget.
external entity Extmark {
    buffer: Buffer
    row: Integer
    col: Integer
    text: String
    full_line: Boolean
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A single rendered cell inside a data row. Positions are byte columns
-- (from the parser), but display_width is measured in display columns so
-- that double-width glyphs (CJK, emoji) are counted correctly.
value Cell {
    start_col: Integer
    end_col: Integer
    display_width: Integer
}

-- A single column of the delimiter (`---`) row. Its width is the common
-- width shared by every data row's cell in that column, so that rows and
-- delimiter stay visually aligned.
value DelimCol {
    width: Integer
    alignment: left | center | right | default
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum DecoratorState { idle | running }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The delimiter row of a pipe table. Carries the authoritative per-column
-- widths that every data row must conform to when rendered.
entity DelimRow {
    node_start_col: Integer
    cols: List<DelimCol>

    -- Total display width of the delimiter once rendered, including the
    -- outer pipes and the per-column fill. This is the reference width all
    -- rows must match (see invariant AllRowsMatchDelimiterWidth).
    rendered_width: Integer
}

-- A data row of a pipe table. Holds the original cells with their measured
-- display widths; when rendered under horizontal scroll, each cell is
-- re-fitted to the corresponding DelimCol width.
entity Row {
    owner: Table
    node_start_col: Integer
    cols: List<Cell>
}

-- A pipe table: a delimiter row plus zero or more data rows. Identity is
-- the table node in the buffer. Note that the rendered width of a row is
-- reconstructed from delimiter column widths (not raw cell widths) so
-- every row visually matches the delimiter; see rule RenderRowWhenScrolled
-- and invariant AllRowsMatchDelimiterWidth.
entity Table {
    buffer: Buffer
    delim: DelimRow
    rows: Row with owner = this
}

-- The per-window cache of the last scroll offset observed. A change to any
-- visible window's leftcol invalidates the view and causes a re-render.
entity View {
    buffer: Buffer
    cached_leftcol: Integer
}

-- Debouncer that coalesces render requests for a buffer. Leading-edge: the
-- first request executes immediately and enters `running`. Trailing-edge:
-- a single pending request captured during `running` is flushed when the
-- timer expires; further arrivals overwrite the pending slot.
entity Decorator {
    buffer: Buffer
    state: DecoratorState
    last_tick: Integer
    has_pending: Boolean
    timer_started_at: Timestamp?

    transitions state {
        idle -> running
        running -> idle
        terminal: idle
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- The trailing-edge window during which further render requests are
    -- coalesced into a single pending invocation. The exact duration is
    -- tuning; what matters at the domain level is that a window exists.
    debounce_window: Duration = 200.milliseconds
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- I. Table setup. When a Table is created its DelimRow must already carry
-- per-column widths that dominate every data row's corresponding cell
-- display width. The property is asserted via invariant
-- DelimColWidthIsMaxCellWidth; this rule exists to tie that property to
-- the creation point and to emit a render request.
rule RegisterTable {
    when: table: Table.created
    ensures: RenderRequested(buffer: table.buffer)
}

-- II. Scroll change detection. The View caches the maximum leftcol across
-- all windows showing the buffer; if any window's leftcol differs from the
-- cache, the view is stale and a render is requested.
rule DetectScrollChange {
    when: WindowScrolled(window, buffer)

    let view = View{buffer: buffer}
    requires: exists view
    requires: window.leftcol != view.cached_leftcol

    ensures: view.cached_leftcol = window.leftcol
    ensures: RenderRequested(buffer: buffer)
}

-- III. Delimiter rendering when scrolled. Compute the trim amount by
-- clipping the delimiter's node start against the window leftcol; if any
-- of the delimiter is still visible, emit a full-line overlay at column
-- leftcol containing the delimiter text from trim_amount onwards.
rule RenderDelimWhenScrolled {
    when: RenderTable(table, window)
    requires: window.leftcol > 0

    let trim_amount = max_zero(window.leftcol - table.delim.node_start_col)
    requires: trim_amount < table.delim.rendered_width

    ensures: Extmark.created(
        buffer: table.buffer,
        row: delim_row_of(table),
        col: window.leftcol,
        text: clipped_delim_text(table.delim, trim_amount),
        full_line: true
    )
}

-- IV. Row rendering when scrolled. A row is reconstructed using the
-- delimiter's column widths (not the raw row widths), then clipped by the
-- same trim rule so it visually matches the delimiter.
rule RenderRowWhenScrolled {
    when: RenderTable(table, window)
    requires: window.leftcol > 0
    ensures:
        for row in table.rows:
            let trim_amount = max_zero(window.leftcol - row.node_start_col)
            if trim_amount < table.delim.rendered_width:
                Extmark.created(
                    buffer: table.buffer,
                    row: row_line_of(row),
                    col: window.leftcol,
                    text: clipped_row_text(row, table.delim, trim_amount),
                    full_line: true
                )
}

-- V. Rendering when the buffer is not horizontally scrolled. Instead of
-- full-line overlays the normal path emits per-pipe and per-cell alignment
-- marks (the domain property is: two rendering strategies exist, selected
-- by whether leftcol is zero).
rule RenderTableUnscrolled {
    when: RenderTable(table, window)
    requires: window.leftcol = 0
    ensures:
        for row in table.rows:
            for cell in row.cols:
                Extmark.created(
                    buffer: table.buffer,
                    row: row_line_of(row),
                    col: cell.start_col,
                    text: alignment_text(table.delim, cell),
                    full_line: false
                )
}

-- VI. Borders. A top border above the first row and a bottom border below
-- the last row are only drawn when every row is the same rendered width as
-- the delimiter; otherwise borders are suppressed.
rule RenderTableBorders {
    when: RenderTable(table, window)
    requires: width_equal(table)
    ensures: Extmark.created(
        buffer: table.buffer,
        row: top_border_line(table),
        col: 0,
        text: top_border_text(table),
        full_line: false
    )
    ensures: Extmark.created(
        buffer: table.buffer,
        row: bottom_border_line(table),
        col: 0,
        text: bottom_border_text(table),
        full_line: false
    )
}

-- VII. Debounce: leading edge. A render request that arrives while the
-- decorator is idle fires immediately, transitions the decorator to
-- running, and arms the debounce timer.
rule DebounceLeadingEdge {
    when: RenderRequested(buffer)

    let decorator = Decorator{buffer: buffer}
    requires: exists decorator
    requires: decorator.state = idle

    ensures: decorator.state = running
    ensures: decorator.timer_started_at = now
    ensures: decorator.has_pending = false
    ensures: RenderTableBatch(buffer: buffer)
}

-- VIII. Debounce: request during running. A request that arrives while
-- running is not executed; it is latched as a single pending request and
-- the timer is restarted so the trailing-edge window covers it.
rule DebounceCaptureWhileRunning {
    when: RenderRequested(buffer)

    let decorator = Decorator{buffer: buffer}
    requires: exists decorator
    requires: decorator.state = running

    ensures: decorator.has_pending = true
    ensures: decorator.timer_started_at = now
}

-- IX. Debounce: timer expiry with a pending request. The pending render is
-- executed, the pending flag is cleared, and the timer is restarted to
-- open a fresh trailing-edge window in case another request races in.
rule DebounceFlushPending {
    when: decorator: Decorator.timer_started_at + config.debounce_window <= now
    requires: decorator.state = running
    requires: decorator.has_pending = true

    ensures: decorator.has_pending = false
    ensures: decorator.timer_started_at = now
    ensures: RenderTableBatch(buffer: decorator.buffer)
}

-- X. Debounce: timer expiry with no pending request. The decorator returns
-- to idle, completing the debounce cycle.
rule DebounceIdle {
    when: decorator: Decorator.timer_started_at + config.debounce_window <= now
    requires: decorator.state = running
    requires: decorator.has_pending = false

    ensures: decorator.state = idle
    ensures: decorator.timer_started_at = null
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- I1. Every data row rendered under horizontal scroll ends up the same
-- display width as the delimiter. This is the central alignment property;
-- the fix in commit 92b6fd5 exists to preserve it.
invariant AllRowsMatchDelimiterWidth {
    for table in Tables:
        for row in table.rows:
            rendered_width_of(row, table.delim) = table.delim.rendered_width
}

-- I2. Each delimiter column's width is at least the maximum display width
-- of the corresponding cell across every data row, so rendered rows never
-- have to overflow a column.
invariant DelimColWidthIsMaxCellWidth {
    for table in Tables:
        for col in table.delim.cols:
            col.width >= max_cell_display_width(table, col)
}

-- I3. The trim amount applied when clipping to leftcol is never negative.
-- Captured as the domain counterpart of the `max(0, ...)` in the code.
invariant TrimAmountNonNegative {
    for table in Tables:
        for w in Windows:
            max_zero(w.leftcol - table.delim.node_start_col) >= 0
}

-- I4. The rendered width of a scrolled overlay equals the pre-trim
-- width minus the trim amount (clamped to zero). This is the stronger
-- form of I1: I1 says all rows match the delimiter when scrolled, and
-- I4 additionally pins what that matched width must be as a function
-- of leftcol. Together they rule out both "rows disagree with
-- delimiter" and "everyone agrees on the wrong width".
--
-- This invariant replaces the earlier, weaker NoOverlayWhenFullyClipped
-- invariant. The "no extmark when fully clipped" property is instead
-- captured as guidance on RenderDelimWhenScrolled / RenderRowWhenScrolled
-- (they only emit when trim_amount < source_width).
invariant ScrolledWidthEqualsBaseMinusTrim {
    for table in Tables:
        for w in Windows where w.leftcol > 0:
            let base = table.delim.rendered_width
            let trim = max_zero(w.leftcol - table.delim.node_start_col)
            for row in table.rows:
                rendered_width_of(row, w) = max_zero(base - trim)
}

-- I5. All width calculations used by this spec are measured in display
-- columns (which count CJK and emoji as 2), never in raw byte lengths.
-- This is the property behind the use of strdisplaywidth in the code.
invariant DoubleWidthAware {
    for table in Tables:
        for row in table.rows:
            for cell in row.cols:
                cell.display_width = display_width_of(cell)
}

-- I6. Clipping an overlay at a display-column boundary that falls in
-- the middle of a multi-column glyph preserves the total display width
-- of the result. In practice: if a CJK or emoji glyph straddles the
-- clip edge, its visible half is replaced with an equivalent number
-- of spaces rather than dropped. Without this property, scrolled rows
-- containing double-width cells come out 1-2 columns narrower than
-- rows that only contain ASCII, which violates I1 and I4.
invariant ClipPreservesDisplayWidth {
    for table in Tables:
        for w in Windows where w.leftcol > 0:
            let base = table.delim.rendered_width
            let trim = max_zero(w.leftcol - table.delim.node_start_col)
            trim < base implies
                clipped_row_width(w) = base - trim
}

-- I7. A scrolled overlay extmark is anchored at the BYTE offset whose
-- display-column position equals leftcol, not at the byte value of
-- leftcol itself. nvim_buf_set_extmark interprets `col` as a byte
-- offset; leftcol is a display column. For ASCII-only rows the two
-- coincide, but for rows containing multi-byte glyphs (emoji, CJK)
-- before leftcol, display_col < byte_offset and the two diverge.
-- Passing leftcol directly places the overlay at a buffer byte
-- corresponding to a display column strictly less than leftcol;
-- neovim then clips the overlay's leading display columns offscreen
-- when rendering, so the visible result is the overlay shifted right
-- by the clipped amount. The fix is to compute byte_offset =
-- col_to_byte(row.text, leftcol) and pass that.
--
-- This invariant is independent of I1-I6, which all speak to overlay
-- CONTENT. I7 speaks to overlay PLACEMENT. A row can satisfy I1, I4,
-- and I6 (correct content, correct width) while still violating I7
-- (placed at the wrong buffer position), because the visible symptom
-- of wrong placement is indistinguishable from correct placement when
-- viewed purely as a screen grid -- the shifted overlay gets clipped
-- and the clipped right edge matches the unshifted right edge.
invariant OverlayMarkAtDisplayColByteOffset {
    for table in Tables:
        for w in Windows where w.leftcol > 0:
            for row in table.rows ++ [table.delim]:
                overlay_extmark_col_of(row, w) =
                    byte_offset_of_display_col(row.text, w.leftcol)
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Resolved in the first follow-up pass (tests/hscroll_edge_spec.lua)
-- by running property tests against the fixed code. All of the
-- following render without error and respect I1 / I4 / I6:
--   * Combining characters (e + U+0301) in cells
--   * Zero-width joiner emoji sequences (family emoji) in cells
--   * Tabs inside cells
--   * Header-only pipe tables (header + delimiter, no data rows)
--   * Scroll offset landing on a pipe boundary
--   * Scroll offset equal to (or past) the row's rendered width
--   * Table nested inside list-item indentation
--
-- Resolved in the second follow-up pass (tests/unit/debounce_spec.lua)
-- by introducing lib/clock.lua as a time-injection seam and a fake
-- clock helper (tests/helpers/fake_clock.lua) that advances time
-- deterministically. The following are observable and behave as
-- expected:
--   * Rapid scroll during the debounce window: the leading edge
--     fires immediately on the first request; subsequent requests
--     store their callback in the `pending` slot and reset the
--     trailing timer. When the debounce window elapses with no
--     further events, the trailing callback fires exactly once
--     and observes the final scroll position. Intended UX.
--   * State change during the debounce window (mode, config,
--     anything Updater:run reads): the trailing callback's
--     Updater closes over the per-buffer config reference and
--     re-reads mode/state at run time, so whatever is true when
--     the trailing edge fires is what the trailing render sees.
--     The existing test covers this via config.enabled because
--     headless nvim cannot enter insert mode; the same mechanism
--     applies to render_modes and the diff mode gate.
--   * Window width / resize during the debounce window: the
--     trailing render creates a fresh Context and View, which
--     both read current window state at render time - same
--     mechanism as the mode case above.
--   * Buffer deletion during the debounce window: buffer_state's
--     on_detach destructor closes the Decorator's uv_timer, so
--     the trailing callback never fires. The timer_lifetime test
--     in debounce_spec.lua proves this against the fake clock.

-- The one remaining question does not belong to the debounce
-- machinery; it is about rendering-pipeline refresh semantics and
-- is orthogonal to clock control:
open question "Scroll without cursor movement: does anti-conceal refresh correctly for the currently concealed line? (Not clock-gated; needs a separate scroll-vs-cursor event sequencing test)"
